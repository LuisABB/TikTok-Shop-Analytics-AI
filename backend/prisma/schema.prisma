generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// REPORTES IMPORTADOS
// ──────────────────────────────────────────────────────────────────────────────
model Report {
  id          Int       @id @default(autoincrement())
  report_type String
  filename    String
  import_date DateTime  @default(now())
  start_date  DateTime?
  end_date    DateTime?
  row_count   Int?
  created_at  DateTime  @default(now())

  @@map("reports")
}

// ──────────────────────────────────────────────────────────────────────────────
// PRODUCTOS
// ──────────────────────────────────────────────────────────────────────────────
model Product {
  id                Int                @id @default(autoincrement())
  product_id        String             @unique
  product_name      String
  status            String?
  category          String?
  price             Decimal?           @db.Decimal(15, 2)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  metrics           ProductMetric[]
  search_stats      SearchMetric[]
  video_products    VideoProduct[]
  affiliate_products AffiliateProduct[]

  @@map("products")
}

model ProductMetric {
  id                       Int      @id @default(autoincrement())
  product_id               String
  report_date              DateTime
  channel                  String   @default("all")
  
  // Métricas de ventas básicas
  gmv                      Decimal? @db.Decimal(15, 2)
  orders                   Int?
  sku_orders               Int?     // Pedidos con SKU
  items_sold               Int?     // Artículos vendidos
  customers                Int?
  aov                      Decimal? @db.Decimal(10, 2) // Average Order Value
  
  // Métricas de tráfico total
  impressions              Int?
  views                    Int?
  clicks                   Int?
  add_to_cart              Int?
  ctr                      Decimal? @db.Decimal(10, 8)
  add_to_cart_rate         Decimal? @db.Decimal(10, 8)
  ctor                     Decimal? @db.Decimal(10, 8) // Click to order rate
  conversion_rate          Decimal? @db.Decimal(10, 8)
  
  // Métricas únicas (usuarios únicos)
  unique_impressions       Int?
  unique_clicks            Int?
  unique_ctr               Decimal? @db.Decimal(10, 8)
  unique_add_to_cart_users Int?
  unique_add_to_cart_rate  Decimal? @db.Decimal(10, 8)
  unique_ctor              Decimal? @db.Decimal(10, 8)
  
  // Métricas financieras avanzadas
  gmv_with_tax             Decimal? @db.Decimal(15, 2)
  tax                      Decimal? @db.Decimal(15, 2)
  gmv_with_subsidy         Decimal? @db.Decimal(15, 2) // Con cofinanciación TikTok
  shipping_fees            Decimal? @db.Decimal(15, 2)
  
  // Métricas de devoluciones
  refunds                  Decimal? @db.Decimal(15, 2)
  refunded_items           Int?
  refunded_customers       Int?
  
  created_at               DateTime @default(now())
  product                  Product  @relation(fields: [product_id], references: [product_id])

  @@unique([product_id, report_date, channel])
  @@map("product_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS GLOBALES DE TIENDA
// ──────────────────────────────────────────────────────────────────────────────
model StoreMetric {
  id              Int      @id @default(autoincrement())
  report_date     DateTime @unique
  visitors        Int?
  page_views      Int?
  conversion_rate Decimal? @db.Decimal(10, 8)
  gmv             Decimal? @db.Decimal(15, 2)
  orders          Int?
  customers       Int?
  ctr             Decimal? @db.Decimal(10, 8)
  created_at      DateTime @default(now())

  @@map("store_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS CORE (Shop Analytics / Core Stats)
// ──────────────────────────────────────────────────────────────────────────────
model CoreMetric {
  id                Int      @id @default(autoincrement())
  report_date       DateTime @unique
  gmv               Decimal? @db.Decimal(15, 2)
  orders            Int?
  customers         Int?
  items_sold        Int?
  aov               Decimal? @db.Decimal(15, 2)
  new_customers     Int?
  impressions       Int?     // Espectadores de productos
  clicks            Int?     // Clics de los usuarios en productos
  add_to_cart_users Int?     // Visitante que agregó al carrito
  conversion_rate   Decimal? @db.Decimal(10, 8)
  created_at        DateTime @default(now())

  @@map("core_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS DE VIDEO
// ──────────────────────────────────────────────────────────────────────────────
model VideoMetric {
  id          Int      @id @default(autoincrement())
  report_date DateTime
  video_id    String?
  video_title String?
  author      String?
  vv          Int?
  ctr         Decimal? @db.Decimal(10, 8)
  ctor        Decimal? @db.Decimal(10, 8)
  gmv         Decimal? @db.Decimal(15, 2)
  orders      Int?
  gpm         Decimal? @db.Decimal(15, 4)
  created_at  DateTime @default(now())

  @@map("video_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS DE LIVE
// ──────────────────────────────────────────────────────────────────────────────
model LiveMetric {
  id           Int      @id @default(autoincrement())
  report_date  DateTime
  live_id      String?
  live_title   String?
  viewers      Int?
  peak_viewers Int?
  sessions     Int?     // Transmisiones LIVE del día
  ctr          Decimal? @db.Decimal(10, 8)
  ctor         Decimal? @db.Decimal(10, 8)
  gmv          Decimal? @db.Decimal(15, 2)
  orders       Int?
  gpm          Decimal? @db.Decimal(15, 4)
  duration_sec  Int?     // Duración vista prom. en segundos
  created_at   DateTime @default(now())

  @@map("live_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS DE SERVICIO AL CLIENTE
// ──────────────────────────────────────────────────────────────────────────────
model ServiceMetric {
  id                  Int      @id @default(autoincrement())
  report_date         DateTime
  agent_id            String   @default("")
  agent_alias         String?
  assigned_chats      Int?
  resolved_chats      Int?
  response_rate       Decimal? @db.Decimal(10, 8)
  satisfaction_rate   Decimal? @db.Decimal(10, 8)
  avg_response_time_s Float?
  created_at          DateTime @default(now())

  @@unique([report_date, agent_id])
  @@map("service_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS DIARIAS DE TARJETAS DE PRODUCTO (agregado, sin product_id)
// ──────────────────────────────────────────────────────────────────────────────
model ProductCardDailyMetric {
  id              Int      @id @default(autoincrement())
  report_date     DateTime @unique
  views           Int?
  viewers         Int?
  clicks          Int?
  add_to_cart     Int?
  add_to_cart_users Int?
  customers       Int?
  orders          Int?
  gmv             Decimal? @db.Decimal(15, 2)
  conversion_rate Decimal? @db.Decimal(10, 8)
  ctr             Decimal? @db.Decimal(10, 8)
  created_at      DateTime @default(now())

  @@map("product_card_daily_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS DIARIAS DEL CANAL DE BÚSQUEDA (Channel Stats - Search)
// ──────────────────────────────────────────────────────────────────────────────
model ChannelSearchMetric {
  id                Int      @id @default(autoincrement())
  report_date       DateTime @unique
  gmv               Decimal? @db.Decimal(15, 2)
  aov               Decimal? @db.Decimal(15, 2)
  orders            Int?
  customers         Int?
  impressions       Int?     // Espectadores de productos
  clicks            Int?     // Clics de los usuarios en productos
  add_to_cart_users Int?     // Visitante que agrego al carrito
  conversion_rate   Decimal? @db.Decimal(10, 8)
  ctr               Decimal? @db.Decimal(10, 8)
  created_at        DateTime @default(now())

  @@map("channel_search_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// MÉTRICAS SEO / BÚSQUEDA
// ──────────────────────────────────────────────────────────────────────────────
model SearchMetric {
  id              Int      @id @default(autoincrement())
  report_date     DateTime
  product_id      String?
  keyword         String?
  impressions     Int?
  clicks          Int?
  ctr             Decimal? @db.Decimal(10, 8)
  orders          Int?
  conversion_rate Decimal? @db.Decimal(10, 8)
  gmv             Decimal? @db.Decimal(15, 2)
  created_at      DateTime @default(now())
  product         Product? @relation(fields: [product_id], references: [product_id])

  @@map("search_metrics")
}

// ──────────────────────────────────────────────────────────────────────────────
// VIDEOS INDIVIDUALES (metadata rica de contenido)
// ──────────────────────────────────────────────────────────────────────────────
model Video {
  id                   Int            @id @default(autoincrement())
  video_id             String         @unique
  video_title          String?
  video_caption        String?        @db.Text
  creator_name         String?
  creator_id           String?
  published_at         DateTime
  
  // Métricas de reproducción
  vv                   Int?
  completion_rate      Decimal?       @db.Decimal(10, 8)
  
  // Engagement
  likes                Int?
  comments             Int?
  shares               Int?
  new_followers        Int?
  
  // Performance comercial
  product_impressions  Int?
  product_clicks       Int?
  ctr                  Decimal?       @db.Decimal(10, 8)
  ctor                 Decimal?       @db.Decimal(10, 8)
  gmv                  Decimal?       @db.Decimal(15, 2)
  orders               Int?
  gpm                  Decimal?       @db.Decimal(15, 4)
  
  // Cross-channel
  video_to_live_clicks Int?
  video_to_live_rate   Decimal?       @db.Decimal(10, 8)
  
  // TikTok diagnosis
  diagnosis            String?
  
  created_at           DateTime       @default(now())
  products             VideoProduct[]
  
  @@index([published_at])
  @@index([creator_id])
  @@map("videos")
}

// Relación many-to-many: Videos y Productos
model VideoProduct {
  id          Int     @id @default(autoincrement())
  video_id    String
  product_id  String
  video       Video   @relation(fields: [video_id], references: [video_id])
  product     Product @relation(fields: [product_id], references: [product_id])
  
  @@unique([video_id, product_id])
  @@map("video_products")
}

// ──────────────────────────────────────────────────────────────────────────────
// SESIONES LIVE INDIVIDUALES (análisis granular de transmisiones)
// ──────────────────────────────────────────────────────────────────────────────
model LiveSession {
  id                        Int      @id @default(autoincrement())
  live_id                   String?  @unique
  session_title             String?
  start_time                DateTime
  duration_sec              Int?
  
  // Audiencia
  viewers                   Int?
  avg_viewing_duration_sec  Float?
  avg_viewing_per_viewer    Float?
  
  // Engagement
  likes                     Int?
  comments                  Int?
  shares                    Int?
  new_followers             Int?
  follow_rate               Decimal? @db.Decimal(10, 8)
  comment_rate              Decimal? @db.Decimal(10, 8)
  share_rate                Decimal? @db.Decimal(10, 8)
  like_rate                 Decimal? @db.Decimal(10, 8)
  
  // Performance comercial
  product_impressions       Int?
  product_clicks            Int?
  impressions_per_hour      Int?
  gmv                       Decimal? @db.Decimal(15, 2)
  gmv_per_hour              Decimal? @db.Decimal(15, 2)
  show_gpm                  Decimal? @db.Decimal(15, 4)
  watch_gpm                 Decimal? @db.Decimal(15, 4)
  orders                    Int?
  items_sold                Int?
  customers                 Int?
  aov                       Decimal? @db.Decimal(15, 2)
  ctr                       Decimal? @db.Decimal(10, 8)
  ctor                      Decimal? @db.Decimal(10, 8)
  
  // Ads (si se usan)
  ads_roas                  Decimal? @db.Decimal(15, 4)
  ads_cost                  Decimal? @db.Decimal(15, 2)
  ads_gmv                   Decimal? @db.Decimal(15, 2)
  
  created_at                DateTime @default(now())
  
  @@index([start_time])
  @@map("live_sessions")
}

// ──────────────────────────────────────────────────────────────────────────────
// PERFORMANCE POR CANAL (comparación cross-canal)
// ──────────────────────────────────────────────────────────────────────────────
model ChannelPerformance {
  id              Int      @id @default(autoincrement())
  report_date     DateTime
  channel         String
  
  gmv             Decimal? @db.Decimal(15, 2)
  orders          Int?
  items_sold      Int?
  customers       Int?
  aov             Decimal? @db.Decimal(15, 2)
  
  impressions     Int?
  clicks          Int?
  ctr             Decimal? @db.Decimal(10, 8)
  add_to_cart     Int?
  ctor            Decimal? @db.Decimal(10, 8)
  
  created_at      DateTime @default(now())
  
  @@unique([report_date, channel])
  @@map("channel_performance")
}

// ──────────────────────────────────────────────────────────────────────────────
// PRODUCTOS DE AFILIADOS (programa de influencers)
// ──────────────────────────────────────────────────────────────────────────────
model AffiliateProduct {
  id              Int      @id @default(autoincrement())
  product_id      String
  report_period   String
  
  gross_revenue   Decimal? @db.Decimal(15, 2)
  commission      Decimal? @db.Decimal(15, 2)
  unit_sales      Int?
  
  product         Product  @relation(fields: [product_id], references: [product_id])
  created_at      DateTime @default(now())
  
  @@unique([product_id, report_period])
  @@map("affiliate_products")
}

// ──────────────────────────────────────────────────────────────────────────────
// PEDIDOS INDIVIDUALES (Order List — "Todo pedido" export de TikTok Shop)
// ──────────────────────────────────────────────────────────────────────────────
model Order {
  id               Int         @id @default(autoincrement())
  order_id         String      @unique            // ID único de TikTok
  status           String                         // Completado, Enviado, Cancelado
  substatus        String?                        // Entregado, Cancelado, etc.
  cancel_type      String?                        // Cancel, Return
  order_type       String?                        // Normal, Pre-order
  order_channel    String?                        // LIVE, Videos, Product cards
  creator_handle   String?
  buyer_username   String?
  order_amount     Decimal?    @db.Decimal(15, 2) // Total de la orden
  refund_amount    Decimal?    @db.Decimal(15, 2)
  order_created_at DateTime?                      // Created Time del CSV
  paid_at          DateTime?                      // Paid Time del CSV
  shipped_at       DateTime?
  delivered_at     DateTime?
  cancelled_at     DateTime?
  fulfillment_type String?
  warehouse_name   String?
  payment_method   String?
  state            String?
  city             String?
  created_at       DateTime    @default(now())
  items            OrderItem[]

  @@index([paid_at])
  @@index([status])
  @@index([order_channel])
  @@map("orders")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  order_id             String
  sku_id               String?
  seller_sku           String?
  product_name         String?
  variation            String?
  quantity             Int?
  unit_original_price  Decimal? @db.Decimal(15, 2)
  subtotal_before_disc Decimal? @db.Decimal(15, 2)
  platform_discount    Decimal? @db.Decimal(15, 2)
  seller_discount      Decimal? @db.Decimal(15, 2)
  subtotal_after_disc  Decimal? @db.Decimal(15, 2)
  created_at           DateTime @default(now())
  order                Order    @relation(fields: [order_id], references: [order_id])

  @@index([order_id])
  @@map("order_items")
}
